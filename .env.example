# Google Analytics 4 measurement ID (loaded only after cookie consent)
VITE_GA_MEASUREMENT_ID=

# Google Tag Manager container ID, e.g. GTM-XXXXXXX (loaded only after cookie consent)
VITE_GTM_CONTAINER_ID=

# External booking page URL (e.g. Cal.com, Calendly)
VITE_BOOKING_URL=

# Supabase project URL and anon key (lead writes go through the submit-lead edge function)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Cloudflare Turnstile site key (public)
VITE_TURNSTILE_SITE_KEY=

# Supabase Edge Function secrets (set in Supabase dashboard, not in this repo):
# TURNSTILE_SECRET — Turnstile widget secret
# TURNSTILE_HOSTNAMES — Comma-separated hostnames allowed by siteverify (e.g. virtus-strategy.com,localhost)
